DATABASE_URL=
PORT=3250
# Set to production for deployed sessions to use Secure cookies.
NODE_ENV=
OCR_URL=http://127.0.0.1:3020
DOCUMENTS_DIR=/var/lib/olnoo-insurance/documents
POLICIES_DIR=/var/lib/olnoo-insurance/policies
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
PAYMENT_SECRETS_ENCRYPTION_KEY=
# Comma-separated public origins allowed as YooKassa return_url values in production.
PAYMENT_RETURN_URL_ORIGINS=
# Public YooKassa webhook URL, used only as an operator readiness indicator.
YOOKASSA_WEBHOOK_PUBLIC_URL=
